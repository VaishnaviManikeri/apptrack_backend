# Generate a unique random value for local development.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Copy the MongoDB Atlas connection string from Atlas and keep this file private.
# Include the database name in MONGODB_DATABASE below; do not commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=jobtrack

# Exact browser origin where Vite runs.
FRONTEND_ORIGIN=http://localhost:5173
